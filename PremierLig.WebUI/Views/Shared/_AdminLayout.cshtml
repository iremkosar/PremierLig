
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GoalZone Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #080d18;
            --bg2: #0c1220;
            --card: #111827;
            --elevated: #1c2d42;
            --green: #00e676;
            --blue: #2979ff;
            --live: #ff1744;
            --gold: #ffd600;
            --t1: #eef2ff;
            --t2: #7b96c4;
            --t3: #3d5478;
            --border: #1a2640;
            --sidebar-width: 260px;
            --fd: 'Barlow Condensed', sans-serif;
            --fb: 'Barlow', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--fb);
            background: var(--bg);
            color: var(--t1);
            min-height: 100vh;
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--bg2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-brand-ico {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--green), var(--blue));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .sidebar-brand-txt {
            font-family: var(--fd);
            font-size: 20px;
            font-weight: 800;
        }

            .sidebar-brand-txt span {
                color: var(--green);
            }

        .sidebar-brand-sub {
            font-size: 10px;
            color: var(--t3);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 16px 0;
            overflow-y: auto;
        }

        .nav-section {
            font-family: var(--fd);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--t3);
            padding: 12px 20px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--t2);
            text-decoration: none;
            font-family: var(--fd);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all .2s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: rgba(255,255,255,.04);
                color: var(--t1);
            }

            .nav-item.active {
                color: var(--green);
                border-left-color: var(--green);
                background: rgba(0,230,118,.06);
            }

            .nav-item i {
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .nav-item.danger {
                color: var(--live);
            }

                .nav-item.danger:hover {
                    background: rgba(255,23,68,.06);
                }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            font-size: 11px;
            color: var(--t3);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .api-dot {
            width: 6px;
            height: 6px;
            background: var(--green);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        /* MAIN */
        .main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .topbar {
            background: var(--bg2);
            border-bottom: 1px solid var(--border);
            padding: 0 28px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 99;
        }

        .topbar-title {
            font-family: var(--fd);
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .topbar-badge {
            background: rgba(255,214,0,.09);
            border: 1px solid rgba(255,214,0,.22);
            border-radius: 20px;
            padding: 4px 14px;
            font-family: var(--fd);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--gold);
            text-transform: uppercase;
        }

        .page-content {
            padding: 28px;
            flex: 1;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-ico">⚽</div>
            <div>
                <div class="sidebar-brand-txt">Goal<span>Zone</span></div>
                <div class="sidebar-brand-sub">Admin Panel</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Genel</div>
            <a asp-controller="AdminDashboard" asp-action="Index" class="nav-item">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section">Maçlar</div>
            <a asp-controller="AdminFixture" asp-action="Index" class="nav-item">
                <i class="bi bi-list-ul"></i> Tüm Maçlar
            </a>
            <a asp-controller="AdminFixture" asp-action="Create" class="nav-item">
                <i class="bi bi-plus-circle"></i> Yeni Maç Ekle
            </a>

            <div class="nav-section">Sistem</div>
            <a asp-controller="AdminSeason" asp-action="Index" class="nav-item">
                <i class="bi bi-calendar3"></i> Sezon Yönetimi
            </a>
            <a asp-controller="AdminTeam" asp-action="Index" class="nav-item">
                <i class="bi bi-shield"></i> Takım Yönetimi
            </a>

            <a asp-controller="Home" asp-action="Index" class="nav-item danger" style="margin-top:20px">
                <i class="bi bi-box-arrow-left"></i> Çıkış Yap
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="api-dot"></div>
            API Bağlantısı Aktif
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main-content">
        <div class="topbar">
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-badge"><i class="bi bi-trophy-fill me-1"></i>Premier League</div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>