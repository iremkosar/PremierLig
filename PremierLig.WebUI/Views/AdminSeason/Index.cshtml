@model List<PremierLig.WebUI.Dtos.ResultSeasonDto>
@{
    ViewData["Title"] = "Sezon Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div style="font-size:13px;color:var(--t3)">
        Toplam <strong style="color:var(--t1)">@Model.Count</strong> sezon
    </div>
    <a asp-controller="AdminSeason" asp-action="Create"
       style="display:inline-flex;align-items:center;gap:7px;background:var(--green);color:#000;
              padding:9px 18px;border-radius:8px;font-family:var(--fd);font-size:13px;
              font-weight:800;text-decoration:none">
        <i class="bi bi-plus-lg"></i> Yeni Sezon Ekle
    </a>
</div>

<div style="background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden">
    <table style="width:100%;border-collapse:separate;border-spacing:0 6px">
        <thead>
            <tr>
                <th style="font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
                           text-transform:uppercase;color:var(--t3);padding:8px 12px;border:none">Sezon</th>
                <th style="font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
                           text-transform:uppercase;color:var(--t3);padding:8px 12px;border:none">Başlangıç</th>
                <th style="font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
                           text-transform:uppercase;color:var(--t3);padding:8px 12px;border:none">Bitiş</th>
                <th style="font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
                           text-transform:uppercase;color:var(--t3);padding:8px 12px;border:none">Durum</th>
                <th style="font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
                           text-transform:uppercase;color:var(--t3);padding:8px 12px;border:none">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr style="background:var(--card);transition:all .2s">
                    <td style="padding:12px;border:none;font-family:var(--fd);font-size:15px;font-weight:700;border-radius:8px 0 0 8px">
                        @s.Name
                    </td>
                    <td style="padding:12px;border:none;font-size:12px;color:var(--t2)">
                        @s.StartDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </td>
                    <td style="padding:12px;border:none;font-size:12px;color:var(--t2)">
                        @s.EndDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </td>
                    <td style="padding:12px;border:none">
                        @if (s.IsCurrent)
                        {
                            <span style="background:rgba(0,230,118,.1);color:var(--green);
                                         font-family:var(--fd);font-size:10px;font-weight:700;
                                         letter-spacing:1px;text-transform:uppercase;
                                         padding:3px 10px;border-radius:8px">Aktif</span>
                        }
                        else
                        {
                            <span style="background:rgba(123,150,196,.1);color:var(--t3);
                                         font-family:var(--fd);font-size:10px;font-weight:700;
                                         letter-spacing:1px;text-transform:uppercase;
                                         padding:3px 10px;border-radius:8px">Pasif</span>
                        }
                    </td>
                    <td style="padding:12px;border:none;border-radius:0 8px 8px 0">
                        <div style="display:flex;gap:6px">
                            <a asp-controller="AdminSeason" asp-action="Update"
                               asp-route-id="@s.SeasonId"
                               style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;
                                      border-radius:7px;font-family:var(--fd);font-size:11px;font-weight:700;
                                      text-decoration:none;background:rgba(0,230,118,.08);
                                      border:1px solid rgba(0,230,118,.2);color:var(--green)">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                            <a asp-controller="AdminSeason" asp-action="Delete"
                               asp-route-id="@s.SeasonId"
                               onclick="return confirm('Sezonu silmek istediğinizden emin misiniz?')"
                               style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;
                                      border-radius:7px;font-family:var(--fd);font-size:11px;font-weight:700;
                                      text-decoration:none;background:rgba(255,23,68,.08);
                                      border:1px solid rgba(255,23,68,.2);color:var(--live)">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
