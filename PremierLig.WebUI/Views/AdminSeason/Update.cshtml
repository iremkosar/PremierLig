@model PremierLig.WebUI.Dtos.UpdateSeasonDto
@{
    ViewData["Title"] = "Sezon Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="max-width:600px">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:28px">
        <div style="font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:2px;
                    text-transform:uppercase;color:var(--t3);margin-bottom:20px;
                    padding-bottom:12px;border-bottom:1px solid var(--border)">
            Sezon Düzenle
        </div>

        <form asp-controller="AdminSeason" asp-action="Update" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SeasonId" value="@Model.SeasonId" />
            <input type="hidden" name="LeagueId" value="@Model.LeagueId" />

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Sezon Adı</label>
                    <input name="Name" type="text" value="@Model.Name"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" required />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Başlangıç Tarihi</label>
                    <input name="StartDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" required />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Bitiş Tarihi</label>
                    <input name="EndDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" required />
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <input name="IsCurrent" type="checkbox" value="true" id="isCurrent"
                    @(Model.IsCurrent ? "checked" : "")
                           style="width:18px;height:18px;accent-color:var(--green)" />
                    <label for="isCurrent" style="font-family:var(--fd);font-size:13px;
                                                   font-weight:700;color:var(--t2)">
                        Aktif Sezon
                    </label>
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:24px">
                <button type="submit"
                        style="background:var(--green);color:#000;border:none;border-radius:8px;
                               padding:10px 22px;font-family:var(--fd);font-size:14px;
                               font-weight:800;cursor:pointer">
                    <i class="bi bi-check-lg"></i> Kaydet
                </button>
                <a asp-controller="AdminSeason" asp-action="Index"
                   style="background:var(--elevated);color:var(--t2);border:1px solid var(--border);
                          border-radius:8px;padding:10px 22px;font-family:var(--fd);font-size:14px;
                          font-weight:700;text-decoration:none">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

