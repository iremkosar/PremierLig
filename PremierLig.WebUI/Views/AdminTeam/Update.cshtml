@model PremierLig.WebUI.Dtos.UpdateTeamDto
@{
    ViewData["Title"] = "Takım Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="max-width:600px">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:28px">
        <div style="font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:2px;
                    text-transform:uppercase;color:var(--t3);margin-bottom:20px;
                    padding-bottom:12px;border-bottom:1px solid var(--border)">
            Takım Düzenle
        </div>

        <form asp-controller="AdminTeam" asp-action="Update" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TeamId" value="@Model.TeamId" />

            <div style="display:flex;flex-direction:column;gap:16px">
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Takım Adı</label>
                    <input name="TeamName" type="text" value="@Model.TeamName"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" required />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Kısa Ad</label>
                    <input name="ShortName" type="text" value="@Model.ShortName"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" required />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Logo URL</label>
                    <input name="LogoUrl" type="text" value="@Model.LogoUrl"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Stadyum</label>
                    <input name="StadiumName" type="text" value="@Model.StadiumName"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" />
                </div>
                <div>
                    <label style="font-family:var(--fd);font-size:11px;font-weight:700;
                                  letter-spacing:1.5px;text-transform:uppercase;color:var(--t3);
                                  display:block;margin-bottom:6px">Şehir</label>
                    <input name="City" type="text" value="@Model.City"
                           style="width:100%;background:var(--elevated);border:1px solid var(--border);
                                  color:var(--t1);border-radius:8px;padding:10px 14px;
                                  font-size:14px;font-family:var(--fb)" />
                </div>
            </div>

            <div style="display:flex;gap:10px;margin-top:24px">
                <button type="submit"
                        style="background:var(--green);color:#000;border:none;border-radius:8px;
                               padding:10px 22px;font-family:var(--fd);font-size:14px;
                               font-weight:800;cursor:pointer">
                    <i class="bi bi-check-lg"></i> Kaydet
                </button>
                <a asp-controller="AdminTeam" asp-action="Index"
                   style="background:var(--elevated);color:var(--t2);border:1px solid var(--border);
                          border-radius:8px;padding:10px 22px;font-family:var(--fd);font-size:14px;
                          font-weight:700;text-decoration:none">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

