@{
    ViewData["Title"] = "Maç Olayları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var fixture = ViewBag.Fixture as PremierLig.WebUI.Dtos.ResultFixtureDto;
    var details = ViewBag.Details as List<PremierLig.WebUI.Dtos.ResultMatchDetailDto>;
    var teams = ViewBag.Teams as List<PremierLig.WebUI.Dtos.ResultTeamDto>;
    string GetTeamName(int id) => teams?.FirstOrDefault(t => t.TeamId == id)?.TeamName ?? "—";
    string GetLogoUrl(int id) => teams?.FirstOrDefault(t => t.TeamId == id)?.LogoUrl ?? "";
}

<style>
    .match-header {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .match-teams {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .match-team-name {
        font-family: var(--fd);
        font-size: 20px;
        font-weight: 800;
        color: var(--t1);
    }

    .vs-text {
        font-family: var(--fd);
        font-size: 13px;
        color: var(--t3);
        margin: 0 4px;
    }

    .header-actions {
        display: flex;
        gap: 8px;
    }

    .header-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        font-family: var(--fd);
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        background: var(--elevated);
        border: 1px solid var(--border);
        color: var(--t2);
        cursor: pointer;
        transition: all .2s;
    }

        .header-btn:hover {
            color: var(--t1);
            background: #1e3050;
        }

    .main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        align-items: start;
    }

    .panel {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .panel-header {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .panel-title {
        font-family: var(--fd);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--t3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-body {
        padding: 20px;
    }

    /* TEAM TOGGLE */
    .team-toggle {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border);
        margin-bottom: 16px;
    }

    .team-toggle-btn {
        padding: 12px;
        font-family: var(--fd);
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        background: var(--elevated);
        color: var(--t2);
        border: none;
        transition: all .2s;
    }

        .team-toggle-btn.active {
            background: transparent;
            color: var(--green);
            border: 2px solid var(--green);
            border-radius: 8px;
        }

    /* FORM FIELDS */
    .field-label {
        font-family: var(--fd);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--t3);
        margin-bottom: 6px;
        display: block;
    }

    .field-input {
        width: 100%;
        background: var(--elevated);
        border: 1px solid var(--border);
        color: var(--t1);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        font-family: var(--fb);
        margin-bottom: 14px;
        outline: none;
        transition: border-color .2s;
    }

        .field-input:focus {
            border-color: var(--blue);
        }

    .field-select {
        width: 100%;
        background: var(--elevated);
        border: 1px solid var(--border);
        color: var(--t1);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        font-family: var(--fb);
        margin-bottom: 14px;
        outline: none;
        appearance: none;
        cursor: pointer;
    }

        .field-select option {
            background: var(--card);
        }

    .add-btn {
        width: 100%;
        background: var(--green);
        color: #000;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-family: var(--fd);
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .2s;
        margin-top: 4px;
    }

        .add-btn:hover {
            background: #00c853;
        }

    /* EVENT CARDS */
    .event-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: var(--elevated);
        border-radius: 10px;
        margin-bottom: 8px;
        transition: background .2s;
    }

        .event-card:hover {
            background: #1e3050;
        }

    .event-minute {
        font-family: var(--fd);
        font-size: 16px;
        font-weight: 900;
        color: var(--t2);
        min-width: 36px;
        text-align: center;
    }

    .event-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .icon-Goal {
        background: rgba(0,230,118,.15);
    }

    .icon-YellowCard {
        background: rgba(255,214,0,.15);
    }

    .icon-RedCard {
        background: rgba(255,23,68,.15);
    }

    .icon-Substitution {
        background: rgba(41,121,255,.15);
    }

    .event-info {
        flex: 1;
    }

    .event-team-name {
        font-family: var(--fd);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 2px;
    }

    .event-desc {
        font-family: var(--fb);
        font-size: 13px;
        font-weight: 600;
        color: var(--t1);
    }

    .event-action {
        font-family: var(--fb);
        font-size: 11px;
        color: var(--t3);
    }

    .del-btn {
        background: none;
        border: none;
        color: var(--live);
        cursor: pointer;
        opacity: 0.5;
        transition: opacity .2s;
        padding: 4px;
        text-decoration: none;
        font-size: 14px;
    }

        .del-btn:hover {
            opacity: 1;
            color: var(--live);
        }

    .empty-state {
        padding: 48px 20px;
        text-align: center;
        color: var(--t3);
        font-family: var(--fd);
        font-size: 12px;
        letter-spacing: 1px;
    }

        .empty-state i {
            font-size: 28px;
            display: block;
            margin-bottom: 10px;
            opacity: 0.4;
        }
</style>

@* HEADER *@
@if (fixture != null)
{
    var homeTeam = teams?.FirstOrDefault(t => t.TeamId == fixture.HomeTeamId);
    var awayTeam = teams?.FirstOrDefault(t => t.TeamId == fixture.AwayTeamId);

    <div class="match-header">
        <div class="match-teams">
            <img src="@homeTeam?.LogoUrl" style="width:40px;height:40px;object-fit:contain" />
            <span class="match-team-name">@homeTeam?.TeamName</span>
            <span class="vs-text">vs</span>
            <span class="match-team-name">@awayTeam?.TeamName</span>
            <img src="@awayTeam?.LogoUrl" style="width:40px;height:40px;object-fit:contain" />
        </div>
        <div class="header-actions">
            <a asp-controller="AdminFixture" asp-action="Index" class="header-btn">
                <i class="bi bi-arrow-left"></i> Maçlara Dön
            </a>
        </div>
    </div>
}

@* MAIN GRID *@
<div class="main-grid">

    @* SOL: FORM *@
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="bi bi-plus-circle"></i> Yeni Olay Ekle</div>
        </div>
        <div class="panel-body">
            <form asp-controller="AdminMatchEvent" asp-action="Create" method="post" id="eventForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="FixtureId" value="@fixture?.FixtureId" />
                <input type="hidden" name="TeamId" id="selectedTeamId" value="@fixture?.HomeTeamId" />

                @* TAKIM TOGGLE *@
                <label class="field-label">Takım</label>
                <div class="team-toggle">
                    @if (fixture != null && teams != null)
                    {
                        var ht = teams.FirstOrDefault(t => t.TeamId == fixture.HomeTeamId);
                        var at = teams.FirstOrDefault(t => t.TeamId == fixture.AwayTeamId);
                        <button type="button" class="team-toggle-btn active" id="homeBtn"
                                onclick="selectTeam(@fixture.HomeTeamId, 'homeBtn')">
                            @ht?.TeamName
                        </button>
                        <button type="button" class="team-toggle-btn" id="awayBtn"
                                onclick="selectTeam(@fixture.AwayTeamId, 'awayBtn')">
                            @at?.TeamName
                        </button>
                    }
                </div>

                @* OLAY TİPİ *@
                <label class="field-label">Olay Tipi</label>
                <select name="ActionType" class="field-select" required>
                    <option value="">Seçin...</option>
                    <option value="Goal">⚽ Gol</option>
                    <option value="YellowCard">🟨 Sarı Kart</option>
                    <option value="RedCard">🟥 Kırmızı Kart</option>
                    <option value="Substitution">🔄 Değişiklik</option>
                </select>

                @* DAKİKA *@
                <label class="field-label">Dakika</label>
                <input type="number" name="Minute" class="field-input" min="1" max="120" placeholder="45" required />

                @* AÇIKLAMA *@
                <label class="field-label">Açıklama</label>
                <input type="text" name="Description" class="field-input" placeholder="Kafa golü, Faul vb." />

                <button type="submit" class="add-btn">
                    <i class="bi bi-plus-lg"></i> Olayı Ekle
                </button>
            </form>
        </div>
    </div>

    @* SAĞ: OLAYLAR *@
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="bi bi-list-ul"></i> Mevcut Olaylar</div>
            @if (details != null && details.Any())
            {
                <span style="font-family:var(--fd);font-size:11px;font-weight:700;
                             background:var(--elevated);padding:3px 10px;border-radius:20px;color:var(--t2)">
                    @details.Count OLAY
                </span>
            }
        </div>
        <div class="panel-body">
            @if (details == null || !details.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    Henüz olay eklenmemiş
                </div>
            }
            else
            {
                @foreach (var d in details.OrderBy(x => x.Minute))
                {
                    var icon = d.ActionType switch
                    {
                        "Goal" => "⚽",
                        "YellowCard" => "🟨",
                        "RedCard" => "🟥",
                        "Substitution" => "🔄",
                        _ => "•"
                    };
                    var actionTr = d.ActionType switch
                    {
                        "Goal" => "Gol",
                        "YellowCard" => "Sarı Kart",
                        "RedCard" => "Kırmızı Kart",
                        "Substitution" => "Değişiklik",
                        _ => d.ActionType
                    };
                    <div class="event-card">
                        <div class="event-minute">@(d.Minute)'</div>
                        <div class="event-icon icon-@d.ActionType">@icon</div>
                        <div class="event-info">
                            <div class="event-team-name">@GetTeamName(d.TeamId)</div>
                            <div class="event-desc">@actionTr</div>
                            @if (!string.IsNullOrEmpty(d.Description))
                            {
                                <div class="event-action">@d.Description</div>
                            }
                        </div>
                        <a asp-controller="AdminMatchEvent" asp-action="Delete"
                           asp-route-id="@d.MatchDetailId"
                           asp-route-fixtureId="@d.FixtureId"
                           class="del-btn"
                           onclick="return confirm('Olayı silmek istiyor musunuz?')">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    function selectTeam(teamId, btnId) {
        document.getElementById('selectedTeamId').value = teamId;
        document.querySelectorAll('.team-toggle-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(btnId).classList.add('active');
    }
</script>